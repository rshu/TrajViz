              },
              "actor_name": {
                "type": "string"
              },
              "composition": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/composition"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Per-boundary visible category estimates, or null when history reconstruction was bounded/unavailable."
              },
              "evidence_quality": {
                "$ref": "#/$defs/evidence_quality"
              }
            },
            "additionalProperties": true
          }
        },
        "composition_history": {
          "type": "object",
          "required": [
            "complete",
            "computed_requests",
            "total_requests",
            "limitations"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "computed_requests": {
              "type": "integer",
              "minimum": 0
            },
            "total_requests": {
              "type": "integer",
              "minimum": 0
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Coverage of bounded per-request composition history. Uncomputed boundaries remain present with a null composition."
        },
        "request_order": {
          "type": "object",
          "required": [
            "basis",
            "chronological",
            "limitations"
          ],
          "properties": {
            "basis": {
              "enum": [
                "recorded_timestamp",
                "source_order"
              ]
            },
            "chronological": {
              "type": "boolean"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Presentation order is chronological only when all boundary clocks are present and agree with each context's recorded lineage."
        }
      },
      "additionalProperties": true
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "composition": {
      "type": "object",
      "required": [
        "evidence",
        "basis",
        "total",
        "partial",
        "categories",
        "component_count"
      ],
      "properties": {
        "evidence": {
          "const": "estimated"
        },
        "basis": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "boolean"
        },
        "component_count": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "label",
              "estimated_tokens",
              "component_count"
            ],
            "properties": {
              "category": {
                "enum": [
                  "system",
                  "tools",
                  "rules",
                  "skills",
                  "mcp",
                  "subagents",
                  "conversation",
                  "tool_outputs",
                  "summarized",
                  "unattributed"
                ]
              },
              "label": {
                "type": "string"
              },
              "estimated_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "component_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "description": "Estimated recorded visible component composition, kept separate from observed prompt occupancy. Category totals reconcile to total without scaling to provider usage."
    },
    "component_segment": {
      "type": "object",
      "required": [
        "category",
        "category_basis",
        "logical_id",
        "identity_basis",
        "content_hash",
        "occurrence_id",
        "provenance",
        "json_pointer",
        "estimated_tokens",
        "role"
      ],
      "properties": {
        "category": {
          "enum": [
            "system",
            "tools",
            "rules",
            "skills",
            "mcp",
            "subagents",
            "conversation",
            "tool_outputs",
            "summarized",
            "unattributed"
          ]
        },
        "category_basis": {
          "type": "string"
        },
        "logical_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable source/native identity scoped to recorded context; null when no safe identity is known."
        },
        "identity_basis": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "occurrence_id": {
          "type": "string",
          "description": "The request-scoped occurrence of this component or segment."
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Recorded native or normalized source references. Request membership references do not imply a known original file source."
        },
        "json_pointer": {
          "type": "string",
          "description": "JSON pointer relative to the original component content; component location identifies its request field."
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "content",
            "framing"
          ]
        },
        "serialized_span": {
          "type": "object",
          "required": [
            "start",
            "end",
            "basis"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "basis": {
              "const": "measured_component_json"
            }
          },
          "description": "Optional non-overlapping source range in the measured JSON serialization; framing ranges account for wrapper tokens."
        }
      },
      "additionalProperties": true,
      "description": "A non-overlapping semantic component part, referencing original content rather than duplicating it."
    },
    "evidence_quality": {
      "type": "object",
      "required": [
        "status",
        "content_complete",
        "missing_references",
        "unsupported_settings",
        "transport_omitted",
        "estimation",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "content_complete": {
          "type": "boolean",
          "description": "Whether recorded component references were recovered. This does not verify the final provider request."
        },
        "missing_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reference",
              "reason",
              "source_refs"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shape",
                  "message",
                  "base",
                  "prefix",
                  "catalog"
                ]
              },
              "reference": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "not_recorded",
                  "invalid",
                  "conflicting",
                  "inspection_limit"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "unsupported_settings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transport_omitted": {
          "type": "boolean"
        },
        "estimation": {
          "type": "object",
          "required": [
            "token_counts",
            "provider_request_verified"
          ],
          "properties": {
            "token_counts": {
              "const": "character_estimate"
            },
            "provider_request_verified": {
              "const": false
            }
          },
          "additionalProperties": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
