{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step durations",
  "description": "Per-step duration without sub-agent spawn wait, its error kind, and whether it is a spike.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "step_durations"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agents",
        "average_s",
        "steps"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "average_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "agent",
              "duration_s",
              "error_kind",
              "outlier",
              "position",
              "spawn_adjusted",
              "step"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "duration_s": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "error_kind": {
                "type": [
                  "null",
                  "string"
                ],
                "enum": [
                  null,
                  "system",
                  "tool"
                ]
              },
              "outlier": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "position": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "spawn_adjusted": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "step": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
