{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Token usage by step",
  "description": "Per-step tokens in disjoint segments (fresh input, cache read, cache write, output, reasoning) that add up to the step total; steps with an impossible count list it under `invalid`.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "token_usage"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "chart"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "agents",
        "format",
        "has_breakdown",
        "steps"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "format": {
          "type": "string"
        },
        "has_breakdown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "agent",
              "cache_read",
              "cache_write",
              "fresh_input",
              "invalid",
              "output",
              "position",
              "reasoning",
              "step",
              "total",
              "usable_total"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "cache_read": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cache_write": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "fresh_input": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "invalid": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                }
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "position": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "step": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "usable_total": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "availability": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "observed",
                    "partial",
                    "unavailable",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
