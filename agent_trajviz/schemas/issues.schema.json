{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issues",
  "description": "Ranked triage of what went wrong: errors, then wasted work, then latency; each issue names its steps.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "description",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "issues"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "const": "table"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "detail",
          "judgment",
          "kind",
          "source_id",
          "steps",
          "title",
          "why"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "judgment": {
            "type": [
              "null",
              "object"
            ],
            "required": [
              "where",
              "fix",
              "also",
              "confidence"
            ],
            "properties": {
              "where": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              },
              "also": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "error",
              "risk",
              "antipattern",
              "bottleneck"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "observed",
              "partial",
              "total",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "partial",
                  "unavailable",
                  "unknown"
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
