# Sample .env for TrajViz — copy to `.env` and fill in.
# Used by:
#   - the dashboard AI Trajectory Analysis sidebar (ANALYZE_* , falls back to LABEL_*)
#   - the step labeler, agent-trajviz-label (LABEL_*)
# `.env` is gitignored; keep your real API key out of version control.

# --- Dashboard analysis (AI Trajectory Analysis sidebar) ------------------
# If these are unset, the sidebar uses LABEL_* below.

# API base URL for the selected provider.
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Anthropic:    https://api.anthropic.com   (TrajViz appends /v1/messages; a base ending in /v1 also works)
#   Self-hosted:  http://localhost:8000/v1
ANALYZE_BASE_URL=https://api.openai.com/v1

# API key for the provider above.
ANALYZE_API_KEY=sk-xxxxx-xxxxx

# Replace this example with a model identifier available on your endpoint.
ANALYZE_MODEL=gpt-4o-mini

# Provider flavor: "openai" (default, OpenAI-compatible chat/completions)
# or "anthropic" (native Anthropic messages API).
ANALYZE_PROVIDER=openai
# Default reply language outside the dashboard (default: English).
# The dashboard uses its Reply language dropdown, initially matching EN | 中.
# ANALYZE_LANGUAGE=Simplified Chinese

# Sampling temperature falls back to LABEL_TEMPERATURE, then 0.2.
# Set ANALYZE_TEMPERATURE= to omit temperature from the request.
# ANALYZE_TEMPERATURE=0.2

# Max response tokens (default 8192). Reasoning models spend part of this on hidden thinking.
# ANALYZE_MAX_TOKENS=8192

# HTTP timeout in seconds (default 120).
# ANALYZE_TIMEOUT=120

# Optional extra HTTP headers as one-line JSON. Auth uses the resolved API key.
# Headers apply only to the matching BASE_URL and PROVIDER. LABEL_HEADERS can
# supply headers when the analysis and labeling endpoints match.
# ANALYZE_HEADERS={"X-HW-ID": "com.huawei.ocean_maas", "X-HW-APPKEY": "xxxx"}

# --- Step labeler (agent-trajviz-label) -----------------------------------
# Also used as fallback for the dashboard analysis sidebar.

LABEL_BASE_URL=https://api.openai.com/v1
LABEL_API_KEY=sk-xxxxx-xxxxx
LABEL_MODEL=gpt-5.4
LABEL_PROVIDER=openai
LABEL_TEMPERATURE=0.3
LABEL_MAX_TOKENS=4096
# LABEL_HEADERS={"X-HW-ID": "com.huawei.ocean_maas", "X-HW-APPKEY": "xxxx"}
